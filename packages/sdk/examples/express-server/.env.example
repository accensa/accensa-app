# Configuration for the x402 seller example (index.ts).
#
#     cp .env.example .env    # then fill it in
#
# index.ts validates this contract at boot through env.ts: everything below is
# checked in one pass, all problems are listed in a single message, optional
# values fall back to the defaults shown (each fallback logged), and a missing
# `.env` is judged on its contents instead of crashing before our code runs.

# ---------------------------------------------------------------------------
# Required — the example refuses to boot without these
# ---------------------------------------------------------------------------

# Ed25519 private key (hex) used to sign settlement reports.
# Your Accensa deployment verifies these against the matching public key.
ACCENSA_PRIVATE_KEY_HEX=

# Stellar address that receives payment.
MERCHANT_ADDRESS=

# ---------------------------------------------------------------------------
# Optional — fall back to the defaults shown, each fallback logged at boot
# ---------------------------------------------------------------------------

# Your Accensa deployment. Fallback: http://localhost:3000.
ACCENSA_URL=http://localhost:3000

# Asset to price in. Fallback: native XLM's testnet SAC.
# Must match an asset your Accensa indexer watches.
TOKEN_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Port to listen on. Fallback: 3001 (validated first — a non-numeric PORT
# also falls back, with a warning).
PORT=3001

# Bearer token for this example's own /admin/stats route. Unrelated to x402.
# Unset: the route rejects every request (fail closed) — warned at boot.
ADMIN_TOKEN=

PORT=3001

# Note: Environment variables should be securely injected in production environments. Avoid checking .env files into version control.
