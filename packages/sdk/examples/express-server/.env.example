# Environment for the @accensa/sdk express-server example.
#
# Copy to `.env` in this directory. Sections mirror what index.ts reads:
# values marked REQUIRED abort boot with the variable named (index.ts's
# required() helper fails at startup, not at settlement time); the rest fall
# back to the defaults below with no warning needed.

# ---------------------------------------------------------------------------
# 1. Required — the example will not start without these
# ---------------------------------------------------------------------------

# Ed25519 private key (hex) used to sign settlement reports.
# Your Accensa deployment verifies these against the matching public key.
ACCENSA_PRIVATE_KEY_HEX=

# Stellar address that receives payment.
MERCHANT_ADDRESS=

# ---------------------------------------------------------------------------
# 2. Optional — documented defaults
# ---------------------------------------------------------------------------

# Your Accensa deployment. Defaults to http://localhost:3000.
ACCENSA_URL=http://localhost:3000

# Asset to price in. Defaults to native XLM's testnet SAC.
# Must match an asset your Accensa indexer watches.
TOKEN_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Bearer token for this example's own /admin/stats route (seller-owned,
# unrelated to x402). Unset means /admin/stats rejects every request and the
# server logs a warning at boot saying the admin surface is disabled.
ADMIN_TOKEN=

# Port for the example server. Integer 1-65535; defaults to 3001.
PORT=3001

# Note: Environment variables should be securely injected in production
# environments. Avoid checking .env files into version control.
