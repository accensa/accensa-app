{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["*.ts", "src/**/*.ts", "generated/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.d.ts", "examples"]
}
