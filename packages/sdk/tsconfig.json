{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx"
  },
  "include": ["*.ts", "src/**/*.ts", "src/**/*.tsx", "generated/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.d.ts", "examples"]
}
