{
  "name": "@accensa/sdk",
  "version": "0.1.0",
  "description": "Middleware hook and receipt verification for Accensa, the merchant back-office for x402 sellers on Stellar",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/accensa/accensa-app.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/accensa/accensa-app/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./merkle": {
      "types": "./dist/merkle.d.ts",
      "import": "./dist/merkle.mjs",
      "require": "./dist/merkle.js"
    },
    "./receipt-anchor": {
      "types": "./dist/receipt-anchor.d.ts",
      "import": "./dist/receipt-anchor.mjs",
      "require": "./dist/receipt-anchor.js"
    },
    "./receipt-anchor-client": {
      "types": "./dist/receipt-anchor-client.d.ts",
      "import": "./dist/receipt-anchor-client.mjs",
      "require": "./dist/receipt-anchor-client.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.mjs",
      "require": "./dist/webhooks.js"
    },
    "./retry": {
      "types": "./dist/retry.d.ts",
      "import": "./dist/retry.mjs",
      "require": "./dist/retry.js"
    },
    "./currency": "./currency.ts",
    "./zk-proof": {
      "types": "./dist/zk-proof.d.ts",
      "import": "./dist/zk-proof.mjs",
      "require": "./dist/zk-proof.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.mjs",
      "require": "./dist/events/index.js"
    },
    "./subscription": {
      "types": "./dist/subscription/index.d.ts",
      "import": "./dist/subscription/index.mjs",
      "require": "./dist/subscription/index.js"
    },
    "./session/express": {
      "types": "./dist/session/express.d.ts",
      "import": "./dist/session/express.mjs",
      "require": "./dist/session/express.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "lint": "node scripts/check-lint-scripts.mjs && ../../apps/web/node_modules/.bin/eslint --config eslint.config.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:vectors": "node scripts/generate-vectors.mjs",
    "gen:api": "openapi-typescript ../../apps/web/openapi.yaml -o ./generated/api-types.ts && prettier --write ./generated/api-types.ts",
    "check-bundle-size": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1"
  },
  "peerDependencies": {
    "express": ">=4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.3",
    "@types/supertest": "^7.2.1",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.2.2",
    "tsup": "^8.0.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  }
}
