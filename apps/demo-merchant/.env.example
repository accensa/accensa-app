# Configuration for the demo merchant (server.js).
#
#     cp .env.example .env    # then fill it in
#
# server.js loads `.env` through lib/env.js, which validates this contract at
# boot: everything below is checked in one pass, problems are listed together,
# and every fallback is logged — nothing fails silently (#344).

# ---------------------------------------------------------------------------
# Required — the seller refuses to start without these
# ---------------------------------------------------------------------------

# Stellar address that receives the paid XLM.
# Without it, boot fails with an EnvError naming this variable rather than
# paying to a placeholder address that cannot receive payments.
MERCHANT_ADDRESS=

# ---------------------------------------------------------------------------
# Optional — fall back to the defaults shown, each fallback logged at boot
# ---------------------------------------------------------------------------

# Port for the demo merchant server. Fallback: 3001 (validated first — a
# non-numeric PORT also falls back, with a warning).
PORT=3001

# Where to report route attribution. Fallback: http://localhost:3000.
ACCENSA_URL=http://localhost:3000

# Asset to price in. Fallback: native XLM's testnet SAC.
# Must match an asset the Accensa indexer watches (ASSET_CONTRACT_IDS).
TOKEN_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# ---------------------------------------------------------------------------
# Optional secrets — unset means the feature is explicitly off (logged)
# ---------------------------------------------------------------------------

# Bearer token for the Accensa /api/hook/settle endpoint.
# Unset: settlements still succeed, but attribution reporting to Accensa is
# skipped — warned once at boot (and again when a settlement is skipped).
# The demo-merchant uses this legacy pattern; the SDK example uses Ed25519
# signatures instead — see packages/sdk/examples/express-server.
HOOK_API_KEY=

# Shared secret for verifying inbound webhook signatures from Accensa.
# Must match the WEBHOOK_SECRET configured in the Accensa deployment.
# Unset: permissive dev mode — signatures are accepted unchecked (logged).
WEBHOOK_SECRET=
