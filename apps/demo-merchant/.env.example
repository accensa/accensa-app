# Environment for the Accensa demo merchant.
#
# Copy to `.env` — all three entrypoints (server.js, agent.js, drive.js) load
# it via dotenv. Every variable below is parsed and validated in lib/env.js:
# required values abort boot with the variable named, optional values fall
# back with a warning, and malformed values are errors, never guesses.
#
# Sections mirror the consumers; nothing here is read by more than one group
# unless marked.

# ---------------------------------------------------------------------------
# 1. Merchant server — server.js
# ---------------------------------------------------------------------------

# Port for the demo merchant server. Integer 1-65535; defaults to 3001.
PORT=3001

# Stellar address that receives payment (G…). Required: the server refuses to
# boot without it, because an invalid payTo silently loses every settled
# transfer instead of failing loudly.
MERCHANT_ADDRESS=

# Where to report route attribution. Defaults to http://localhost:3000.
# Must be an absolute http(s) URL; a trailing slash is normalised away.
ACCENSA_URL=http://localhost:3000

# Bearer token for the Accensa /api/hook/settle endpoint.
# The demo-merchant uses this legacy pattern; the SDK example uses Ed25519
# signatures instead — see packages/sdk/examples/express-server.
# Optional: unset means attribution reports are skipped (logged at boot and
# per settlement).
HOOK_API_KEY=

# Shared secret for verifying inbound webhook signatures from Accensa.
# Must match the WEBHOOK_SECRET configured in the Accensa deployment.
# Leave unset to skip signature verification (permissive dev mode — logged at
# boot so the mode is never ambiguous).
WEBHOOK_SECRET=

# Asset to price in. Defaults to native XLM's testnet SAC.
# Must match an asset the Accensa indexer watches (ASSET_CONTRACT_IDS).
TOKEN_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# ---------------------------------------------------------------------------
# 2. Paying agent & dashboard driver — agent.js, drive.js
# ---------------------------------------------------------------------------

# Payer's Ed25519 secret key (testnet, funded). Required by agent.js and
# drive.js; never logged by either. See README.md for how to fund one.
STELLAR_PRIVATE_KEY=

# Base URL of the running demo merchant. Defaults to http://localhost:3001.
# Absolute http(s) URL only; trailing slash is normalised away.
MERCHANT_URL=http://localhost:3001

# Comma-separated routes for agent.js to pay. Defaults to the two priced
# routes; entries that are whitespace-only are rejected at boot rather than
# quietly shrinking the run.
ROUTES=/api/hello,/api/insights/daily

# Soroban RPC endpoint for the payer. Optional: unset falls back to the
# testnet default inside lib/x402-payer.js.
STELLAR_RPC_URL=

# ---------------------------------------------------------------------------
# Production note: environment variables should be securely injected in
# production environments. Avoid checking .env files into version control.
# ---------------------------------------------------------------------------
