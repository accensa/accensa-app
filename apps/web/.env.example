# apps/web environment template.
#
# Copy to apps/web/.env.local. Values below are empty on purpose: this file
# must not carry credentials. Comments name the fallback the code uses when a
# variable is unset, and who is expected to supply a real value.
#
# Derived from process.env reads in apps/web/src (including src/proxy.ts),
# apps/web/sentry.*.config.ts (via src/lib/sentry-scrub.ts), and
# apps/web/playwright*.config.ts. Test-only reads are listed at the bottom
# and are not required to boot the app.

# ---------------------------------------------------------------------------
# Required — the app throws or refuses the request when these are missing.
# Leave blank here. Supply them from your host, not from this file.
# ---------------------------------------------------------------------------

# Postgres connection string. Required by connectionString() in src/lib/db.ts.
# No fallback (a committed default would be a published credential).
# Supplied by the operator (local Postgres or the host's session pooler).
# This is the variable README.md asks you to hand-write at the sample
# DATABASE_URL line; copy this template instead of inventing .env.local.
DATABASE_URL=

# Signs and verifies session cookies. Required. No fallback.
# Supplied by the operator. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Bearer secret for cron and internal routes (src/proxy.ts, src/lib/cron-auth.ts).
# Required for those routes. No fallback. Supplied by the operator.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional — code supplies the fallback shown when the variable is unset.
# ---------------------------------------------------------------------------

# Set by Next.js. development | production | test.
NODE_ENV=

# Stellar RPC. Default: https://soroban-testnet.stellar.org
# Supplied by the operator when not using testnet.
STELLAR_RPC_URL=

# Server-side network passphrase. Default: Stellar SDK Networks.TESTNET
# ("Test SDF Network ; September 2015"). Supplied by the operator for mainnet.
STELLAR_NETWORK_PASSPHRASE=

# Server-side network name used by stellarAuth. No default (falls through to
# NEXT_PUBLIC_STELLAR_NETWORK). testnet | mainnet. Supplied by the operator.
STELLAR_NETWORK=

# Public network name for explorer links. Default: testnet.
# Recognised: testnet, mainnet, public, pubnet. An unknown value throws.
# Supplied by the operator.
NEXT_PUBLIC_STELLAR_NETWORK=

# Public passphrase for client transaction builders. Default: Networks.TESTNET.
# Supplied by the operator for mainnet.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=

# Public RPC for client submits. Default: https://soroban-testnet.stellar.org
# Supplied by the operator.
NEXT_PUBLIC_STELLAR_RPC_URL=

# Comma-separated SAC contract ids watched by sync. Default: testnet native
# XLM SAC CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC.
# Supplied by the operator.
ASSET_CONTRACT_IDS=

# Merchant Stellar account (G…). Optional for receipt simulation, which falls
# back to GCALKSGAZRJLSUEJT3M5W6LN4R7XQOLIRCOS6ZA6EDZVTZDBIIPPFKJ6.
# Required by /api/anchor/preview (503 when unset). Supplied by the merchant.
MERCHANT_ADDRESS=

# Optional merchant key stored beside MERCHANT_ADDRESS. No default.
# Supplied by the merchant. Leave blank.
MERCHANT_PUBLIC_KEY=

# Outbound merchant webhook. No default; delivery is skipped when unset.
# Supplied by the merchant.
WEBHOOK_URL=

# Shared secret checked when delivering webhooks. No default.
# Supplied by the merchant. Leave blank.
WEBHOOK_SECRET=

# Signing key for webhook delivery. No default. Supplied by the operator.
# Leave blank.
WEBHOOK_SIGNING_KEY=

# Max age in ms for a signed settlement report. Default: 300000 (5 minutes).
# Non-numeric or non-positive values keep the default. Supplied by the operator.
HOOK_MAX_AGE_MS=

# Upstash Redis REST endpoint and token. Both must be set or rate limiting,
# CSP reports, reservation limits, and TOTP limits use their in-memory fallback.
# Supplied by the operator. Leave blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SpiceDB HTTP API. Unset disables the remote store. Supplied by the operator.
SPICEDB_API_URL=

# SpiceDB bearer token. Falls back to SPICEDB_PRESHARED_KEY, then empty.
# Supplied by the operator. Leave blank.
SPICEDB_API_TOKEN=
SPICEDB_PRESHARED_KEY=

# Discord-style webhook for sync alerts. Unset disables the alert. Operator.
SYNC_ALERT_WEBHOOK_URL=

# Webhook for security alerts. Unset disables the alert. Operator.
SECURITY_ALERT_WEBHOOK_URL=

# Ledger lag that marks sync health as warn. Default: 60000.
SYNC_LAG_WARN_LEDGERS=

# Ledger lag that marks sync health as critical. Default: 90000.
SYNC_LAG_CRITICAL_LEDGERS=

# Milliseconds without a sync before health is critical. Default: 10800000 (3h).
SYNC_STALE_MS=

# Facilitator health URL. Unset reports the facilitator as not configured.
# Supplied by the operator.
FACILITATOR_URL=

# CSV export row cap. Default: 10000 when unset, empty, or not a positive integer.
# Supplied by the operator.
CSV_EXPORT_MAX_ROWS=

# Minimum log level: debug, info, warn, error. Default: info.
LOG_LEVEL=

# Public Sentry DSN, read so the client bundle can inline it. Unset disables
# Sentry. Supplied by the operator. Leave blank.
NEXT_PUBLIC_SENTRY_DSN=

# Traces sample rate from 0 to 1. Default: 1. Invalid values use the default.
# Read by sentry.client.config.ts, sentry.server.config.ts, and
# sentry.edge.config.ts through src/lib/sentry-scrub.ts.
SENTRY_TRACES_SAMPLE_RATE=

# Refund vault contract id (C…). No default; the client hides the action when
# unset. Supplied by the operator. Leave blank.
NEXT_PUBLIC_REFUND_VAULT_ID=

# Receipt-anchor contract id. Default: CBHRJU7CF4XIFRNDITFHNQHABKBMFM2FYFHLGWN3JGSFYYCDSMDAWPRV.
# Supplied by the operator when the deployment differs.
NEXT_PUBLIC_RECEIPT_ANCHOR_ID=

# ABI version for that contract. Default: the SDK V1 version ("v1").
RECEIPT_ANCHOR_ABI_VERSION=

# Set by GitHub Actions. Playwright uses it for retries, the reporter, and
# whether to reuse an existing server. Leave unset locally.
CI=

# Port for playwright.config.ts. Default: 3100.
PLAYWRIGHT_PORT=

# ---------------------------------------------------------------------------
# Excluded — read only by tests, not by application code.
# Do not set these for a normal deploy.
# ---------------------------------------------------------------------------
#
# DATABASE_SHARDS
#   apps/web/src/lib/db.sharding.test.ts
#   apps/web/src/lib/shard-router.test.ts
#   Production routing takes an env object argument; it does not read
#   process.env.DATABASE_SHARDS itself.
