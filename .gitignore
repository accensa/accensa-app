# Coding-agent scratch state, including git worktrees under .claude/worktrees.
# Untracked but not ignored means one `git add -A` away from committing several
# full copies of the tree.
.claude/

# Local scratch: PR bodies passed to `gh pr create --body-file`, issue dumps,
# one-off fix scripts. See CONTRIBUTING.md — keep these under .scratch/ so they
# never end up tracked at the repo root (body.txt / issues.json did once).
.scratch/
/body.txt
/issues.json
/fetch_issues.py
/issues.md
/pr_body.md
/patch_ci.js
/patch_index.js
/patch_route.js
/patch_test.js
/patch_workspace.js
/fix_test.js
/fix_type.js
/fix_type2.js

# This is a pnpm workspace; pnpm-lock.yaml is the only lockfile.
# Stray npm/yarn lockfiles drift from it and change which package manager
# Vercel detects for a project.
package-lock.json
yarn.lock

# Rust project artifacts
Cargo.lock
target/
**/target/**
**/Cargo.toml.lock

# Next.js generated file
apps/web/next-env.d.ts
